{
  "name": "@thinger-io/n8n-nodes-thinger",
  "version": "1.0.5",
  "description": "n8n node for interacting with the Thinger.io API",
  "keywords": [
    "n8n-community-node-package",
    "thinger.io",
    "IoT",
    "arduino",
    "raspberry"
  ],
  "license": "MIT",
  "homepage": "https://thinger.io",
  "author": {
    "name": "Thinger.io",
    "email": "support@thinger.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinger-io/n8n-nodes-thinger.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier nodes credentials --write"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ThingerTokenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Thinger/Thinger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "latest",
    "@types/node": "^22.10.1",
    "prettier": "^3.4.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
